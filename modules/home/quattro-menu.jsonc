{
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install","when":"[[ ${KEYSTONE_MENU_SHOW_INSTALL:-false} == true ]]","action":"keystone-menu install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"],"when":"[[ ${KEYSTONE_MENU_SHOW_UPDATE:-false} == true ]]","action":"keystone-menu update"},
  "about": {"icon":"","label":"About","action":"keystone-menu about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  "learn.keybindings": {"icon":"","label":"Keybindings","description":"Search the active Hyprland bindings","action":"keystone-menu keybindings"},
  "learn.keystone": {"icon":"󰧑","label":"Keystone","description":"Keystone documentation","action":"keystone-menu docs-keystone"},
  "learn.hyprland": {"icon":"","label":"Hyprland","description":"Hyprland documentation","action":"keystone-menu docs-hyprland"},
  "learn.nixos": {"icon":"","label":"NixOS","description":"NixOS documentation","action":"keystone-menu docs-nixos"},

  "trigger.photos": {"icon":"","label":"Photos","when":"[[ ${KEYSTONE_MENU_SHOW_PHOTOS:-false} == true ]]","action":"keystone-menu photos"},
  "trigger.agents": {"icon":"󰚩","label":"Agents","when":"[[ ${KEYSTONE_MENU_SHOW_AGENTS:-false} == true ]]","action":"keystone-menu agents"},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","description":"Capture, annotate, or copy a region","action":"keystone-menu screenshot"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screen recording","checked":"pgrep -f '(^|/)gpu-screen-recorder([[:space:]]|$)' >/dev/null","action":"keystone-menu screenrecord"},
  "trigger.toggle": {"icon":"󰔎","label":"Toggles","aliases":["toggle","toggles"]},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","checked":"! pgrep -x hypridle >/dev/null","action":"keystone-menu idle-toggle"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"keystone-menu nightlight-toggle"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","checked":"[[ ! -e ${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/bar-off ]]","action":"keystone-menu bar-toggle"},

  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"keystone-menu theme"},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"keystone-menu background"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar","action":"keystone-menu bar-settings"},

  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"keystone-menu monitors"},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"],"action":"keystone-menu wifi"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agent","title":"Default Agent"},
  "setup.default.agent.agy": {"icon":"󰫢","label":"Antigravity","when":"command -v agy >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"agy\" ]]","action":"keystone-menu default-agent agy"},
  "setup.default.agent.claude": {"icon":"󰛄","label":"Claude","when":"command -v claude >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"claude\" ]]","action":"keystone-menu default-agent claude"},
  "setup.default.agent.codex": {"icon":"","iconFont":"omarchy","label":"Codex","when":"command -v codex >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"codex\" ]]","action":"keystone-menu default-agent codex"},
  "setup.default.agent.copilot": {"icon":"","label":"Copilot","when":"command -v copilot >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"copilot\" ]]","action":"keystone-menu default-agent copilot"},
  "setup.default.agent.crush": {"icon":"󰋑","label":"Crush","when":"command -v crush >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"crush\" ]]","action":"keystone-menu default-agent crush"},
  "setup.default.agent.grok": {"icon":"","iconFont":"omarchy","label":"Grok","when":"command -v grok >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"grok\" ]]","action":"keystone-menu default-agent grok"},
  "setup.default.agent.hermes": {"icon":"","iconFont":"omarchy","label":"Hermes","when":"command -v hermes >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"hermes\" ]]","action":"keystone-menu default-agent hermes"},
  "setup.default.agent.omp": {"icon":"","iconFont":"omarchy","label":"omp","when":"command -v omp >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"omp\" ]]","action":"keystone-menu default-agent omp"},
  "setup.default.agent.opencode": {"icon":"","iconFont":"omarchy","label":"OpenCode","when":"command -v opencode >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"opencode\" ]]","action":"keystone-menu default-agent opencode"},
  "setup.default.agent.ori": {"icon":"","iconFont":"omarchy","label":"Ori","when":"command -v ori >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"ori\" ]]","action":"keystone-menu default-agent ori"},
  "setup.default.agent.pi": {"icon":"","iconFont":"omarchy","label":"Pi","when":"command -v pi >/dev/null 2>&1","checked":"[[ \"$(keystone-menu default-agent)\" == \"pi\" ]]","action":"keystone-menu default-agent pi"},
  "setup.audio": {"icon":"󰕾","label":"Audio","action":"keystone-menu audio"},
  "setup.printers": {"icon":"󰐪","label":"Printers","action":"keystone-menu printers"},
  "setup.hardware": {"icon":"","label":"Hardware","when":"[[ ${KEYSTONE_MENU_SHOW_HARDWARE:-false} == true ]]","action":"keystone-menu hardware"},
  "setup.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"command -v fprintd-enroll >/dev/null 2>&1","action":"keystone-menu fingerprint"},
  "setup.accounts": {"icon":"󰀉","label":"Accounts","action":"keystone-menu accounts"},
  "setup.secrets": {"icon":"󰌾","label":"Secrets","when":"[[ ${KEYSTONE_MENU_SHOW_SECRETS:-false} == true ]]","action":"keystone-menu secrets"},

  "remove.managed": {"icon":"","label":"Managed by NixOS","description":"Remove software from the owning Nix configuration","disabled":"true","action":"keystone-menu remove-info"},

  "system.lock": {"icon":"","label":"Lock","action":"keystone-menu lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","action":"keystone-menu suspend"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"keystone-menu logout"},
  "system.restart": {"icon":"󰜉","label":"Restart","action":"keystone-menu restart"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"keystone-menu shutdown"}
}
